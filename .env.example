# ==================== 主服务：基础运行 ====================
# 运行环境：development / test / production
APP_ENV=development
# API 监听地址和端口
API_HOST=0.0.0.0
API_PORT=8000
# 当前版本必须使用单 Worker，保证 Run、SSE 和取消状态一致
API_WORKERS=1
# Metadata SQLite 数据库地址
METADATA_DATABASE_URL=sqlite+aiosqlite:///./storage/metadata.db

# ==================== 主服务：受控存储目录 ====================
# 上传数据源的根目录
DATASOURCE_ROOT=./storage/datasources
# 正式 Artifact 的根目录
ARTIFACT_ROOT=./storage/artifacts
# Python 分析脚本工作区根目录
SCRIPT_WORKSPACE_ROOT=./storage/script-workspaces
# 运行时诊断 Trace 根目录
RUNTIME_TRACE_ROOT=./storage/runtime-traces
# Session 级临时工作区根目录
SESSION_WORKSPACE_ROOT=./storage/session-workspaces
# Python Sandbox 使用的镜像名称
SANDBOX_IMAGE=datapilot-analysis:0.1.0
# 主后端加密密钥；生产环境必须填写，且不能提交到 Git
SECRET_MASTER_KEY=

# ==================== DataLink：服务连接 ====================
# 主后端访问 DataLink REST 和 MCP 的地址
DATALINK_BASE_URL=http://localhost:8100
DATALINK_MCP_URL=http://localhost:8100/mcp
# API 与 DataLink 共享；本地统一启动脚本会为每次启动注入临时值
DATALINK_SERVICE_TOKEN=
# 主后端调用 DataLink 的单次超时（秒）
DATALINK_TIMEOUT_SECONDS=180
# DataLink 服务自身监听地址和端口
DATALINK_HOST=0.0.0.0
DATALINK_PORT=8100
# DataLink 可读取的数据源根目录和图谱数据库
DATALINK_SOURCE_ROOT=./storage/datasources
DATALINK_DATABASE_PATH=./storage/datalink/datalink.db
# DataLink 回调主后端消费连接授权的受控地址
DATALINK_CONTROL_URL=http://127.0.0.1:8011

# ==================== DataLink：模型和语义建图 ====================
# DataLink 建图模型配置；密钥不能提交到 Git
DATALINK_LLM_PROVIDER=openai-compatible
DATALINK_LLM_MODEL=
DATALINK_LLM_BASE_URL=
DATALINK_LLM_API_KEY=
# DataLink 建图模型采样温度、输出 token 和单次请求超时
DATALINK_LLM_TEMPERATURE=0.0
DATALINK_LLM_MAX_TOKENS=16384
DATALINK_LLM_TIMEOUT_SECONDS=120
# 可选的向量模型；留空表示不启用 embedding
DATALINK_EMBEDDING_MODEL=

# ==================== 数据访问和上传 ====================
# SQL 未指定 LIMIT 时使用的默认行数
DEFAULT_QUERY_LIMIT=100
# SQL LIMIT 和工具返回结果允许的最大行数
MAX_QUERY_LIMIT=500
# 单次只读查询超时（秒）
QUERY_TIMEOUT_SECONDS=60
# 上传文件大小上限（MB）
MAX_UPLOAD_MB=100

# ==================== Run：阶段时间和模型输出 ====================
# 准备阶段共享窗口（秒）
ANALYSIS_PREPARATION_MAX_SECONDS=240
# Opening 协议选择模型调用上限（秒）
RUN_OPENING_TIMEOUT_SECONDS=60
# DataLink 语义上下文阶段上限（秒）
ANALYSIS_SEMANTIC_CONTEXT_TIMEOUT_SECONDS=30
# Discovery 后分析计划定稿模型调用上限（秒）
ANALYSIS_PLAN_FOLLOWUP_TIMEOUT_SECONDS=120
# 为 Claim 提交和最终答案保留的最低时间（秒）
ANALYSIS_FINAL_RESERVE_SECONDS=45
# Claim 提交阶段模型调用上限（秒）
ANALYSIS_COMMIT_TIMEOUT_SECONDS=120
# 普通 Agent 数据分析单轮模型调用上限（秒）
ANALYSIS_AGENT_TURN_TIMEOUT_SECONDS=120
# 最终答案模型调用上限（秒）
FINAL_ANSWER_TIMEOUT_SECONDS=45
# 流式最终答案分片之间允许的最大空闲时间（秒）
FINAL_ANSWER_IDLE_TIMEOUT_SECONDS=30
# 主 Agent 单次模型输出 token 上限
AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
# 未在 Model Profile 中指定时使用的模型上下文窗口 token 数
MODEL_CONTEXT_WINDOW_TOKENS=32768
# Python Sandbox 单次脚本执行上限（秒）
PYTHON_SANDBOX_TIMEOUT_SECONDS=30

# ==================== Run：Agent Graph 业务预算 ====================
# 单个数据分析 Run 允许的 Agent 最大回合数，范围 4～40
AGENT_MAX_TURNS=20
# 单个 Run 允许执行的 SQL/Python/DataLink 数据工具调用总数，范围 1～32
AGENT_MAX_DATA_TOOL_CALLS=16
# 同一阶段连续工具失败后收尾的次数上限，范围 1～5
AGENT_MAX_STAGE_TOOL_FAILURES=2
# Claim 提交校验失败后的重试次数上限，范围 1～3
AGENT_MAX_COMMIT_VALIDATION_FAILURES=2
# 普通 SQL 被安全拒绝后允许的不同 SQL 改写次数，范围 0～3
AGENT_MAX_SQL_REPAIRS=2
# Discovery 探索尝试次数：初次查询加一次修复，范围 1～2
AGENT_MAX_DISCOVERY_ATTEMPTS=2
# 发送给 Agent 模型的最大工作集消息数，范围 8～64
AGENT_MAX_MODEL_MESSAGES=32
# Agent 工作集字符预算上限，范围 16000～128000
AGENT_MAX_MODEL_CONTEXT_CHARS=64000
# 单条工具观察进入模型上下文前的字符上限，范围 8000～64000
AGENT_MAX_TOOL_MESSAGE_CHARS=32000
# 上下文压缩循环最大步骤数，范围 32～512
AGENT_MAX_COMPACTION_STEPS=256
# 单个用户目标允许的结构化检查项数量，范围 1～16
AGENT_MAX_ASSERTIONS_PER_REQUIREMENT=4
# 单个分析 Run 允许的结构化检查项总数，范围 1～32
AGENT_MAX_TOTAL_ASSERTIONS=8
# 单个检查项允许的查询尝试次数，范围 1～8
AGENT_MAX_QUERY_ATTEMPTS_PER_ASSERTION=3
# 同一检查项重复同类合同错误后的熔断阈值，范围 1～5
AGENT_MAX_ASSERTION_FAILURES=2

# ==================== 可观测性 ====================
# 是否启用 LangSmith 原生 LangChain/LangGraph Trace
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DataPilot

# ==================== Web ====================
# 允许访问 API 的前端来源，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173
# Vite 开发服务器访问 API 的地址
VITE_API_BASE_URL=http://localhost:8000
